# Synthetic Arena — environment variables template.
#
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
#
# Generation hints for secrets:
#   openssl rand -base64 32     # for SALT, NEXTAUTH_SECRET, MINIO/REDIS/CH passwords
#   openssl rand -hex 32        # for ENCRYPTION_KEY (must be 32-byte hex)

# ---- Gameplay agent (real-game tier) ----

# The only credential the agent needs. It must match the adapter selected
# below: an OpenAI key for `openai`, an OpenCode Zen key for `zen`, an
# Anthropic key for `anthropic`.
AOE2_LLM_API_KEY=

# Which adapter serves the models. Each supplies its own endpoint, so this is
# the only variable you change to switch vendor:
#   openai     api.openai.com          (default)
#   zen        opencode.ai/zen/v1      OpenCode Zen
#   anthropic  api.anthropic.com
# Case and surrounding whitespace are tolerated. An unrecognised name stops
# the agent at startup rather than running a default you did not choose.
AOE2_LLM_WIRE=openai

# Endpoint override. Leave empty to use the adapter's own endpoint. Set it only
# to reach a non-default host, such as a staging gateway or a self-hosted proxy.
AOE2_LLM_BASE_URL=

# Model overrides, one per role. The defaults follow AOE2_LLM_WIRE, because a
# model name belongs to its vendor:
#   openai, zen   gpt-5.6-luna / gpt-5.6-terra / gpt-5.6-luna
#   anthropic     claude-haiku-4-5 / claude-sonnet-5 / claude-haiku-4-5
# Set a variable here to override that role alone. Empty means "unset".
# AOE2_MODEL=            # executor: one call per turn, so pick speed
# AOE2_STRATEGIST_MODEL= # strategist: one call per 3-10 turns, so pick reasoning
# AOE2_MEMORY_MODEL=     # post-game extraction and prompt mutation, so pick price

# ---- Gameplay agent: Windows VM ----

# Where the agent sends /detect. Empty runs YOLO locally on the VM, which is
# slow under x86 emulation. Point it at the Mac running `just server`.
AOE2_DETECTION_HOST=

# Turns between strategist calls. Lower costs more and plans more often.
AOE2_STRATEGIST_INTERVAL=10

# Write every frame to logs/. Costs about 3 ms per frame, so leave it on.
AOE2_SAVE_SCREENSHOTS=true

# Resource-bar reader: rapidocr (pip-only) | tesseract (needs the binary) |
# template.
AOE2_OCR_BACKEND=rapidocr

# ---- Synthetic Arena: Langfuse ----

# Random salt used for password hashing inside Langfuse.
LANGFUSE_SALT=

# Session-cookie signing secret for the Langfuse web app.
LANGFUSE_NEXTAUTH_SECRET=

# 32-byte hex string for encrypting API keys at rest.
LANGFUSE_ENCRYPTION_KEY=

# Password for the Langfuse Postgres backing store.
LANGFUSE_DB_PASSWORD=

# ---- Synthetic Arena: ClickHouse ----

CLICKHOUSE_PASSWORD=

# ---- Synthetic Arena: Redis ----

REDIS_PASSWORD=

# ---- Synthetic Arena: MinIO (S3-compatible object store) ----

MINIO_ROOT_USER=arena
MINIO_ROOT_PASSWORD=

# ---- Synthetic Arena: agent → OTel collector ----

# Where the agent (native, not containerized) sends OTLP spans. The collector
# listens here when `just arena-infra-up` is running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Langfuse first-boot bootstrap (Option 2) ---
# Provisions a dev org/project/user the first time langfuse-web boots against
# an empty DB. After `arena-infra-nuke` these are re-applied. Project keys are
# used by the Langfuse SDK; user email/password log into the UI at :3000.
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME="Local Dev"
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=aoe2-arena
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local
LANGFUSE_INIT_USER_EMAIL=dev@local.dev
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=devpassword
