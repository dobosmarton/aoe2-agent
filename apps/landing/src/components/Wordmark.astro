---
import { Swords } from "lucide-react";

type Props = {
  href?: string;
  size?: "sm" | "md";
};

const { href = "/", size = "md" } = Astro.props;
const textClass = size === "sm" ? "text-sm" : "text-base";
---

<a href={href} class="group inline-flex items-center gap-2.5 font-heading font-bold tracking-tight text-foreground">
  <span
    class="inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border border-foreground/10 bg-card text-accent-foreground"
    aria-hidden="true"
  >
    <Swords className="h-4 w-4 duration-300 group-hover:scale-110" />
  </span>
  <span class:list={[textClass, "whitespace-nowrap"]}>
    AoE2 <span class="text-muted-foreground">·</span> LLM Arena
  </span>
</a>
