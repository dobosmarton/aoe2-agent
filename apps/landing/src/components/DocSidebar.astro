---
import { SECTIONS } from "@/lib/taxonomy";

interface Props {
  /** Full slug of the currently rendered doc (e.g. "agent/overview"). */
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const referenceGroups = [
  {
    label: "Runbooks",
    items: [
      { href: "/docs/runbooks/deployment", label: "Deployment" },
      { href: "/docs/runbooks/windows-vm-agent-bringup", label: "Windows VM agent bring-up" },
      { href: "/docs/runbooks/retrain-detector", label: "Retrain the detector" },
      { href: "/docs/runbooks/baseline-experiments", label: "Baseline experiments" },
      { href: "/docs/runbooks/redis-broker-ops", label: "Redis broker operations" },
      { href: "/docs/runbooks/switching-broker-backend", label: "Switching the broker backend" },
      { href: "/docs/runbooks/debug-stuck-fork", label: "Debugging a stuck fork" },
    ],
  },
  {
    label: "Decisions",
    items: [
      { href: "/docs/adr/0001-broker-first-architecture", label: "0001 Broker-first event architecture" },
      { href: "/docs/adr/0002-redis-streams-for-cross-process", label: "0002 Redis Streams for cross-process events" },
      { href: "/docs/adr/0003-basedpyright", label: "0003 basedpyright" },
      { href: "/docs/adr/0004-bradley-terry-ranking", label: "0004 Bradley-Terry ranking" },
      { href: "/docs/adr/0005-arena-ui-stack", label: "0005 Arena UI stack" },
    ],
  },
  {
    label: "Appendix",
    items: [
      {
        href: "/docs/appendix/01-yolo-and-object-detection",
        label: "A · YOLO and object detection",
      },
      {
        href: "/docs/appendix/02-event-brokers-and-redis-streams",
        label: "B · Event brokers and Redis Streams",
      },
      {
        href: "/docs/appendix/03-bradley-terry-and-bootstrap",
        label: "C · Bradley-Terry and the bootstrap",
      },
    ],
  },
  {
    label: "Reference",
    items: [
      { href: "/docs/index", label: "Documentation index" },
      { href: "/docs/glossary", label: "Glossary" },
    ],
  },
];
const groupLabel = "mb-3 block font-mono text-[11px] tracking-wider text-muted-foreground uppercase";
---

<nav class="space-y-8 text-sm" aria-label="Documentation navigation">
  <div>
    <p class={groupLabel}><span aria-hidden="true">[ </span>Guide<span aria-hidden="true"> ]</span></p>
    <ol class="space-y-4">
      {
        SECTIONS.map((section) => (
          <li>
            <p class="mb-1.5 font-heading font-bold text-foreground">{section.title}</p>
            <ul class="border-l border-foreground/10">
              {section.pages.map((page) => {
                const slug = `${section.id}/${page.slug}`;
                const isActive = currentSlug === slug;
                return (
                  <li>
                    <a
                      href={`/docs/${slug}`}
                      title={page.blurb}
                      class:list={[
                        "-ml-px block border-l-2 py-1 pr-2 pl-3 leading-snug transition-colors",
                        isActive
                          ? "border-accent-foreground font-medium text-foreground"
                          : "border-transparent text-muted-foreground hover:text-foreground",
                      ]}
                    >
                      {page.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
  {
    referenceGroups.map((group) => (
      <div>
        <p class={groupLabel}><span aria-hidden="true">[ </span>{group.label}<span aria-hidden="true"> ]</span></p>
        <ul class="border-l border-foreground/10">
          {group.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="-ml-px block border-l-2 border-transparent py-1 pr-2 pl-3 leading-snug text-muted-foreground transition-colors hover:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
