---
// The home page's opening: one real agent turn as a scroll-driven 3D scene. The stage
// stays pinned while the chapter articles scroll over it; their scroll position drives
// the scene (scene/timeline.ts). The articles are plain HTML, so the page reads the
// same without JavaScript, with reduced motion or without WebGL: then the stage turns
// into a banner and each chapter shows a still of its scene (data-mode="static").
import { ArrowRight } from "lucide-react";

import { FIRST_PAGE } from "@/lib/taxonomy";
import { CHAPTERS } from "./chapters";

const KEYS = ["q", "q", "hover", "click", "h"];
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="walkthrough" class="wt dark" data-mode="static" aria-labelledby="wt-title">
  <div class="wt-stage" data-wt-stage>
    <img
      class="wt-poster"
      src="/walkthrough/stills/hero.jpg"
      alt=""
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
    />
    <div class="wt-view" data-wt-view aria-hidden="true"></div>
    <div class="wt-shade" aria-hidden="true"></div>

    <div class="wt-hud" aria-hidden="true">
      <p class="wt-stage-label">[ One agent turn · recorded game, Feudal Age ]</p>
      <p class="wt-stamp">capture 3024 × 1672 · every 0.1 s · same bytes for detector and OCR</p>
      <ol class="wt-keys">
        {KEYS.map((key, i) => <li data-key={i}>{key.length === 1 ? <kbd>{key}</kbd> : <span>{key}</span>}</li>)}
      </ol>
      <p class="wt-note">
        Frame, boxes and HUD values come from one recorded game and the served v12 detector. Track IDs, goals and
        placement spots are illustrative.
      </p>
    </div>

    <nav class="wt-rail" aria-label="Walkthrough chapters">
      <span class="wt-rail-track" aria-hidden="true"><span class="wt-rail-fill" data-wt-fill></span></span>
      <ol>
        {
          CHAPTERS.map((c, i) => (
            <li>
              <a href={`#wt-${c.id}`} data-wt-rail={i + 1}>
                <span class="wt-rail-num">{pad(i + 1)}</span>
                <span class="wt-rail-name">{c.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="wt-chapters">
    <article class="wt-hero" data-wt-chapter="0">
      <div class="wt-hero-inner">
        <p class="wt-kicker">[ Gameplay agent · Synthetic arena ]</p>
        <h1 id="wt-title">An AI agent that plays Age of Empires II from screen pixels.</h1>
        <p class="wt-lede">
          A detector and local OCR turn the screen into text, a policy model and two LLMs decide, and mouse and keyboard
          input does the rest. Scroll to follow one turn from a recorded game.
        </p>
        <div class="wt-ctas">
          <a href={`/docs/${FIRST_PAGE.fullSlug}`} class="wt-btn wt-btn-primary">
            Start reading <ArrowRight className="h-4 w-4" />
          </a>
          <a href="#wt-capture" class="wt-btn">Follow one turn</a>
        </div>
      </div>
      <p class="wt-scroll-hint" aria-hidden="true">Scroll</p>
    </article>

    {
      CHAPTERS.map((c, i) => (
        <article id={`wt-${c.id}`} class="wt-chapter" data-wt-chapter={i + 1} style={`--wt-len: ${c.length}`}>
          <img
            class="wt-still"
            src={`/walkthrough/stills/${c.id}.jpg`}
            alt=""
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <div class="wt-card">
            <p class="wt-card-kicker">
              [ {pad(i + 1)} · {c.name} ]
            </p>
            <h2>{c.title}</h2>
            <p set:html={c.body} />
            <a href={`/docs/${c.doc.slug}${c.doc.hash ? `#${c.doc.hash}` : ""}`} class="wt-card-link">
              {c.doc.label} <ArrowRight className="h-3.5 w-3.5" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

{/* Decide the mode before first paint, so the stage does not jump from banner to pinned. */}
<script is:inline>
  (() => {
    const root = document.getElementById("walkthrough");
    if (!root) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduced && "WebGL2RenderingContext" in window) root.dataset.mode = "scene";
    document.querySelector("[data-site-header]")?.classList.add("dark");
  })();
</script>

<script>
  import type { SceneHandle } from "./scene";

  const root = document.getElementById("walkthrough");
  const stage = root?.querySelector<HTMLElement>("[data-wt-stage]");
  const view = root?.querySelector<HTMLElement>("[data-wt-view]");
  const articles = [...(root?.querySelectorAll<HTMLElement>("[data-wt-chapter]") ?? [])];
  const railLinks = [...(root?.querySelectorAll<HTMLAnchorElement>("[data-wt-rail]") ?? [])];
  const fill = root?.querySelector<HTMLElement>("[data-wt-fill]");

  // Scroll position in timeline units: chapter i covers [i, i + 1) while its article
  // passes the middle of the viewport.
  let bounds: { top: number; height: number }[] = [];
  const measure = () => {
    bounds = articles.map((a) => {
      const rect = a.getBoundingClientRect();
      return { top: rect.top + window.scrollY, height: rect.height };
    });
  };
  const progress = () => {
    const line = window.scrollY + window.innerHeight * 0.5;
    for (let i = bounds.length - 1; i >= 0; i--) {
      const b = bounds[i]!;
      if (line >= b.top) return Math.min(i + (line - b.top) / b.height, bounds.length);
    }
    return 0;
  };

  // The site header sits over the dark stage at the top of the page: give it the dark
  // tokens while it does, in either theme.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const syncHeader = () => header?.classList.toggle("dark", (root?.getBoundingClientRect().bottom ?? 0) > 72);

  let scene: SceneHandle | null = null;
  let last = -1;
  const onScroll = () => {
    syncHeader();
    const p = progress();
    if (Math.abs(p - last) < 0.0005) return;
    last = p;
    scene?.setProgress(p);
    const active = Math.floor(p);
    railLinks.forEach((link, i) => {
      if (i + 1 === active) link.setAttribute("aria-current", "step");
      else link.removeAttribute("aria-current");
    });
    if (fill) fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (p - 1) / (bounds.length - 1)))})`;
    root?.toggleAttribute("data-past-hero", p > 0.85);
  };

  const toStatic = () => {
    if (!root) return;
    root.dataset.mode = "static";
    scene?.dispose();
    scene = null;
  };

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });

  if (root && stage && view && root.dataset.mode === "scene") {
    measure();
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      onScroll();
    });
    new ResizeObserver(() => {
      measure();
      onScroll();
    }).observe(root);

    // three.js stays out of the initial bundle: load the scene once the page is idle.
    const load = () =>
      import("./scene")
        .then(({ mountScene }) => mountScene({ view, stage, assets: "/walkthrough" }))
        .then((handle) => {
          scene = handle;
          last = -1;
          onScroll();
          root.dataset.ready = "";
        })
        .catch((error: unknown) => {
          console.warn("walkthrough: falling back to stills", error);
          toStatic();
        });
    if ("requestIdleCallback" in window) window.requestIdleCallback(() => void load(), { timeout: 1200 });
    else window.setTimeout(() => void load(), 300);
  }
</script>
