---
import "../styles/globals.css";
import Wordmark from "@/components/Wordmark.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import SearchPalette from "@/components/SearchPalette.tsx";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "AoE2 LLM Arena — Documentation",
  description = "A two-tier AI agent that plays Age of Empires II: Definitive Edition, plus a synthetic evaluation tier that races prompt/model variants.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {/* Apply theme before first paint to avoid flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const prefersLight =
            window.matchMedia("(prefers-color-scheme: light)").matches;
          const useLight = saved ? saved === "light" : prefersLight;
          if (useLight) document.documentElement.classList.remove("dark");
          else document.documentElement.classList.add("dark");
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-30 border-b bg-background/80 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4">
        <Wordmark />
        <nav class="hidden items-center gap-1 text-sm md:flex">
          <a
            href="/docs/part1-architecture/01-system-overview"
            class="rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            Tutorial
          </a>
          <a
            href="/#packages"
            class="rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            Packages
          </a>
          <a
            href="/#reference"
            class="rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            Reference
          </a>
          <a
            href="https://github.com/dobosmarton/aoe2-agent"
            target="_blank"
            rel="noreferrer"
            class="rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            GitHub
          </a>
        </nav>
        <div class="flex items-center gap-2">
          <button
            id="open-search"
            type="button"
            class="inline-flex h-9 items-center gap-2 rounded-md border bg-background px-3 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
            aria-label="Search docs"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span class="hidden sm:inline">Search</span>
            <kbd class="ml-2 hidden rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground sm:inline">
              ⌘K
            </kbd>
          </button>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <slot />

    <SearchPalette client:idle />

    {/* Pagefind runtime loader. The file only exists in production builds
        (generated by `pagefind --site dist`). In dev it 404s silently and
        search reports the "not built yet" hint. Loaded as a <script>, not a
        dynamic import, so Vite's resolver never sees it. */}
    <script is:inline>
      (() => {
        const PAGEFIND_URL = "/pagefind/pagefind.js";
        import(PAGEFIND_URL)
          .then((mod) => {
            window.pagefind = mod;
            window.dispatchEvent(new Event("pagefind:ready"));
          })
          .catch(() => {
            // Pagefind not built (dev mode or pre-build) — leave undefined.
          });
      })();
    </script>

    <footer class="mt-24 border-t">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-4 py-8 text-sm text-muted-foreground md:flex-row md:items-center">
        <p>AoE2 LLM Arena · Technical documentation</p>
        <p>
          Built with Astro · Source on
          <a href="https://github.com/dobosmarton/aoe2-agent" class="underline hover:text-foreground">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
