---
import "../styles/globals.css";
import Wordmark from "@/components/Wordmark.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import SiteBackground from "@/components/SiteBackground.astro";
import SearchPalette from "@/components/SearchPalette.tsx";
import { BracketLabel, Corners } from "@/components/ui/frame";
import Analytics from "@vercel/analytics/astro";
import { FIRST_PAGE } from "@/lib/taxonomy";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Docs pages: masks the backdrop grid out of the text and shows reading progress. */
  reading?: boolean;
  /** Width of the condensed header card; docs pages use the wider three-column grid. */
  headerMax?: string;
};

const {
  title = "AoE2 LLM Arena: Documentation",
  description = "An agent that plays Age of Empires II: Definitive Edition from screen pixels, plus a detection model and server, a synthetic arena for comparing prompts and models, a web viewer for arena runs, and an autoresearch loop that scores real games.",
  ogImage = "/og-image.jpg",
  reading = false,
  headerMax = "72rem",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const year = new Date().getFullYear();

const NAV_LINKS = [
  { href: `/docs/${FIRST_PAGE.fullSlug}`, label: "Docs" },
  { href: "/#packages", label: "Packages" },
  { href: "/#runbooks", label: "Runbooks" },
  { href: "/docs/glossary", label: "Glossary" },
];
const REPO = "https://github.com/dobosmarton/aoe2-agent";
const footerLink = "text-foreground underline decoration-foreground/20 underline-offset-4 hover:decoration-foreground";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Karla:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {/* Apply theme before first paint to avoid flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
          const useLight = saved ? saved === "light" : prefersLight;
          if (useLight) document.documentElement.classList.remove("dark");
          else document.documentElement.classList.add("dark");
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="text-foreground antialiased">
    <a
      class="absolute top-0 left-0 z-50 m-3 block -translate-y-96 overflow-hidden bg-background p-3 text-lg transition focus:translate-y-0"
      href="#main-content"
    >
      Skip to content
    </a>

    {/* Open and borderless at the top of the page; a floating card with "+" corner
        marks once the page scrolls (the script below sets data-scrolled). */}
    <header class="site-header" data-site-header style={`--header-max: ${headerMax}`}>
      <div class="site-header-bar">
        <span aria-hidden="true" class="site-header-corners pointer-events-none absolute inset-0">
          <Corners className="text-accent-foreground" />
        </span>
        {reading && <span aria-hidden="true" class="header-progress" />}
        <div class="mx-auto flex items-center gap-4 px-4" style={`max-width: ${headerMax}`}>
          <Wordmark />
          <nav class="ml-auto hidden items-center gap-1 text-sm font-medium lg:flex" aria-label="Main">
            {
              NAV_LINKS.map((link) => (
                <a
                  href={link.href}
                  class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-accent-foreground"
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href={REPO}
              target="_blank"
              rel="noreferrer"
              class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-accent-foreground"
            >
              GitHub
            </a>
          </nav>
          <div class="ml-auto flex items-center gap-2 lg:ml-0">
            <button
              id="open-search"
              type="button"
              class="inline-flex h-9 items-center gap-2 rounded-md border border-foreground/10 bg-card px-3 text-sm text-muted-foreground transition-colors hover:text-accent-foreground"
              aria-label="Search docs"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <span class="hidden sm:inline">Search</span>
              <kbd class="ml-2 hidden font-mono text-[11px] tracking-wider text-muted-foreground sm:inline">⌘K</kbd>
            </button>
            <ThemeToggle />
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="pt-20">
      <slot />
    </main>

    <SearchPalette client:idle />

    {/* Pagefind runtime loader. The file only exists in production builds
        (generated by `pagefind --site dist`). In dev it 404s silently and
        search reports the "not built yet" hint. Loaded inside an inline
        script tag (not a top-level dynamic import) so Vite's resolver
        never sees it. NB: do NOT spell the bare angle-bracket script
        token in this comment: Vite's esbuild dep pre-scanner uses a
        naive HTML tokenizer that ignores JSX comments and will treat
        the rest of the comment as script body on cold start. */}
    <script is:inline>
      (() => {
        const PAGEFIND_URL = "/pagefind/pagefind.js";
        import(PAGEFIND_URL)
          .then((mod) => {
            window.pagefind = mod;
            window.dispatchEvent(new Event("pagefind:ready"));
          })
          .catch(() => {
            // Pagefind not built (dev mode or pre-build): leave undefined.
          });
      })();
    </script>

    <footer class="mt-24 border-t border-foreground/10">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:justify-between"
      >
        <div class="space-y-2">
          <BracketLabel>&copy; {year} AoE2 LLM Arena</BracketLabel>
          <p class="font-mono text-[11px] text-muted-foreground">
            Source on <a href={REPO} target="_blank" rel="noreferrer" class={footerLink}>GitHub</a>
            {" · "}Built with Astro
          </p>
        </div>
        <p class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">Technical documentation</p>
      </div>
      <p class="mx-auto max-w-6xl px-4 pb-8 font-mono text-[11px] leading-relaxed text-muted-foreground">
        AoE2 LLM Arena was created under Microsoft's
        <a href="https://www.xbox.com/en-US/developers/rules" target="_blank" rel="noreferrer" class={footerLink}
          >"Game Content Usage Rules"</a
        > using assets from Age of Empires II: Definitive Edition, and it is not endorsed by or affiliated with Microsoft.
      </p>
    </footer>

    <SiteBackground reading={reading} />
    <Analytics />

    <script>
      // The header condenses into a floating card once the page scrolls.
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      const CONDENSE_AT = 8;
      const COPIED_RESET_MS = 1500;

      const update = (): void => {
        header?.toggleAttribute("data-scrolled", window.scrollY > CONDENSE_AT);
      };

      update();
      window.addEventListener("scroll", update, { passive: true });

      // Copy buttons on code cells (lib/rehype-artifacts.ts, components/CodeFigure.astro).
      document.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-copy-code]") : null;
        const code = button?.closest(".code-cell")?.querySelector("pre");

        if (!button || !code) {
          return;
        }

        void navigator.clipboard.writeText(code.innerText.replace(/\n$/, "")).then(() => {
          button.textContent = "Copied";
          button.setAttribute("data-copied", "");

          window.setTimeout(() => {
            button.textContent = "Copy";
            button.removeAttribute("data-copied");
          }, COPIED_RESET_MS);
        });
      });
    </script>
  </body>
</html>
