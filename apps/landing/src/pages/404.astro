---
import Site from "@/layouts/Site.astro";
import { ArrowLeft } from "lucide-react";
import { FIRST_CHAPTER } from "@/lib/taxonomy";
---

<Site title="Not found — AoE2 LLM Arena" description="Page not found.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">
      That page isn't here.
    </h1>
    <p class="mt-3 text-muted-foreground">
      The link may be out of date, or the doc may have moved. Try the tutorial start, or use search.
    </p>
    <div class="mt-6 flex items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-9 items-center gap-2 rounded-md border bg-background px-4 text-sm font-medium hover:bg-accent"
      >
        <ArrowLeft className="h-4 w-4" />
        Home
      </a>
      <a
        href={`/docs/${FIRST_CHAPTER.fullSlug}`}
        class="inline-flex h-9 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        Start the tutorial
      </a>
    </div>
  </div>
</Site>
