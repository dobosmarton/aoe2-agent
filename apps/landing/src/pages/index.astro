---
import Site from "@/layouts/Site.astro";
import GameplayLoopDemo from "@/components/figures/GameplayLoopDemo.tsx";
import PackageMap from "@/components/figures/PackageMap.tsx";
import PhaseTimeline from "@/components/figures/PhaseTimeline.tsx";
import ArenaScreenshots from "@/components/figures/ArenaScreenshots.tsx";
import { getCollection } from "astro:content";
import { FIRST_PAGE, FLAT_PAGES, SECTIONS, getPage } from "@/lib/taxonomy";
import {
  ArrowRight,
  BookOpen,
  Boxes,
  Brain,
  Eye,
  FileCode,
  GitFork,
  Network,
  Rocket,
  Workflow,
} from "lucide-react";

// Reading paths: curated, short routes through the docs so newcomers don't
// have to read every section in order. Each path is a list of page slugs
// from `taxonomy.ts` plus an optional one-line "why this page" note.
// Titles are pulled from taxonomy so they stay in sync if a page is renamed.
type ReadingPathPage = { slug: string; note?: string };
type ReadingPath = {
  title: string;
  duration: string;
  description: string;
  icon: typeof Rocket;
  pages: ReadingPathPage[];
};

const READING_PATHS: ReadingPath[] = [
  {
    title: "15-minute tour",
    duration: "~15 min",
    description:
      "Three pages that give you the whole system in one sitting: how the agent decides, what it sees, and how prompt and model variants are compared.",
    icon: Rocket,
    pages: [
      { slug: "agent/overview", note: "the big picture" },
      { slug: "detection/detector", note: "what the agent sees" },
      { slug: "arena/overview", note: "how variants are compared" },
    ],
  },
  {
    title: "LLM-agent design",
    duration: "6 pages",
    description:
      "If you build LLM agents: a TypeSafe policy next to a strategist and an executor, guarded tools, prompt caching and context, and a prompt-evolution loop scored on real games.",
    icon: Brain,
    pages: [
      { slug: "agent/overview" },
      { slug: "agent/decision-loops" },
      { slug: "agent/llm-providers" },
      { slug: "agent/prompts-and-context" },
      { slug: "autoresearch/overview" },
      { slug: "autoresearch/mutation-and-memory" },
    ],
  },
  {
    title: "Computer vision",
    duration: "5 pages",
    description:
      "If you train detectors or care about synthetic data: the YOLO26n detector and its 65-class taxonomy, serving and evaluation, training data, labeling, and sprite extraction.",
    icon: Eye,
    pages: [
      { slug: "detection/detector" },
      { slug: "detection/serving-and-evaluation" },
      { slug: "detection/training" },
      { slug: "detection/labeling" },
      { slug: "detection/sprite-extraction" },
    ],
  },
  {
    title: "Arena infra",
    duration: "7 pages",
    description:
      "If you build distributed or observability systems: event broker, DuckDB event log, Bradley-Terry ranking, the FastAPI and SSE backend, and the run viewer.",
    icon: Network,
    pages: [
      { slug: "arena/overview" },
      { slug: "arena/event-broker" },
      { slug: "arena/event-log-and-replay" },
      { slug: "arena/ranking" },
      { slug: "arena/world-sim" },
      { slug: "web/architecture" },
      { slug: "web/run-viewer" },
    ],
  },
];

const docs = await getCollection("docs");

// The "Runbooks" section on the home page surfaces /docs/runbooks/* as a flat list.
const runbooks = docs
  .filter((d) => d.id.startsWith("runbooks/"))
  .sort((a, b) => a.id.localeCompare(b.id));

function firstHeading(id: string): string {
  // Astro renders entries with a `body` we could parse; for the landing page
  // the filename is already a reasonable label without an extra fetch.
  return id.split("/").pop()?.replace(/\.md$/, "").replace(/^\d+-/, "") ?? id;
}
---

<Site>
  {/* Hero */}
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-10 lg:pt-16">
    <div class="mb-6 max-w-3xl">
      <div class="mb-3 inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1 text-xs text-muted-foreground">
        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
        Gameplay agent · Synthetic arena
      </div>
      <h1 class="text-balance text-4xl font-bold tracking-tight md:text-5xl">
        An AI agent that plays Age of Empires II from screen pixels.
      </h1>
      <p class="mt-4 text-balance text-lg text-muted-foreground">
        A YOLO detector and local OCR turn the screen into text. A TypeSafe policy picks routine actions, a strategist LLM sets goals,
        and an executor LLM handles combat and recovery. A synthetic arena compares prompt and model variants in a simulated economy,
        and an autoresearch loop scores real games. This site is the technical documentation.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`/docs/${FIRST_PAGE.fullSlug}`}
          class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Start reading
          <ArrowRight className="h-4 w-4" />
        </a>
        <a
          href="#reading-paths"
          class="inline-flex h-10 items-center gap-2 rounded-md border bg-background px-5 text-sm font-medium hover:bg-accent"
        >
          Pick a path
        </a>
        <a
          href="#packages"
          class="inline-flex h-10 items-center gap-2 rounded-md border bg-background px-5 text-sm font-medium hover:bg-accent"
        >
          Browse by package
        </a>
        <a
          href="#runbooks"
          class="inline-flex h-10 items-center gap-2 rounded-md border bg-background px-5 text-sm font-medium hover:bg-accent"
        >
          Runbooks
        </a>
      </div>
    </div>

    <div class="mt-8">
      <GameplayLoopDemo client:load />
    </div>
  </section>

  {/* Three entry-path cards */}
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-4 md:grid-cols-3">
      <a
        href={`/docs/${FIRST_PAGE.fullSlug}`}
        class="group rounded-xl border bg-card p-5 transition-colors hover:border-foreground"
      >
        <BookOpen className="h-5 w-5 text-muted-foreground" />
        <h2 class="mt-3 font-semibold">Read the docs</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          {SECTIONS.length} sections, {FLAT_PAGES.length} pages. Starts at the gameplay agent overview and ends at autoresearch.
        </p>
        <p class="mt-3 inline-flex items-center gap-1 text-sm font-medium">
          Begin <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>
      <a
        href="#packages"
        class="group rounded-xl border bg-card p-5 transition-colors hover:border-foreground"
      >
        <Boxes className="h-5 w-5 text-muted-foreground" />
        <h2 class="mt-3 font-semibold">Browse by package</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Nine Python packages in a uv workspace. Pick the one closest to what you want to change.
        </p>
        <p class="mt-3 inline-flex items-center gap-1 text-sm font-medium">
          Package map <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>
      <a
        href="#runbooks"
        class="group rounded-xl border bg-card p-5 transition-colors hover:border-foreground"
      >
        <FileCode className="h-5 w-5 text-muted-foreground" />
        <h2 class="mt-3 font-semibold">Runbooks</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Operational guides for when something is broken or needs to be restarted.
        </p>
        <p class="mt-3 inline-flex items-center gap-1 text-sm font-medium">
          Open runbooks <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>
    </div>
  </section>

  {/* Reading paths: curated, shorter routes through the docs. */}
  <section id="reading-paths" class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">Pick a reading path</h2>
      <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
        Short curated routes through the docs. Pick the one closest to what you want to learn, or scroll down for the full arc.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {READING_PATHS.map((path) => {
        const Icon = path.icon;
        return (
          <div class="rounded-xl border bg-card p-5">
            <div class="flex items-center gap-2">
              <Icon className="h-4 w-4 text-muted-foreground" />
              <h3 class="font-semibold">{path.title}</h3>
              <span class="ml-auto text-xs text-muted-foreground">{path.duration}</span>
            </div>
            <p class="mt-2 text-sm text-muted-foreground">{path.description}</p>
            <ol class="mt-4 space-y-0.5 text-sm">
              {path.pages.map((c, i) => {
                const flat = getPage(c.slug);
                const title = flat ? `${flat.section.title}: ${flat.page.title}` : c.slug;
                return (
                  <li>
                    <a
                      href={`/docs/${c.slug}`}
                      class="group flex items-baseline gap-2 rounded px-2 py-1 hover:bg-accent"
                    >
                      <span class="font-mono text-xs text-muted-foreground">{i + 1}.</span>
                      <span class="flex-1 group-hover:text-foreground">{title}</span>
                      {c.note && (
                        <span class="hidden text-xs italic text-muted-foreground sm:inline">{c.note}</span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        );
      })}
    </div>
  </section>

  {/* Phase timeline */}
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">The documentation arc</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          The sections in order. Pick a page to jump in.
        </p>
      </div>
      <Workflow className="hidden h-5 w-5 text-muted-foreground md:block" />
    </div>
    <PhaseTimeline client:visible variant="full" />
  </section>

  {/* Package map */}
  <section id="packages" class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">Packages</h2>
      <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
        Nine Python packages in one uv workspace. Most share types through
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">core</code>. Hover a card to see what it depends on.
      </p>
    </div>
    <PackageMap client:visible />
  </section>

  {/* Arena screenshots */}
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">See it in action</h2>
      <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
        The arena run viewer shows a run's state and events turn by turn, and forks a run from any turn. Click any panel to expand.
      </p>
    </div>
    <ArenaScreenshots client:visible />
  </section>

  {/* Runbooks */}
  <section id="runbooks" class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">Runbooks</h2>
      <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
        Operational guides for the moments when something is broken or needs to be restarted.
      </p>
    </div>
    {runbooks.length > 0 ? (
      <ul class="max-w-2xl divide-y divide-border rounded-md border">
        {runbooks.map((d) => (
          <li>
            <a
              href={`/docs/${d.id}`}
              class="flex items-center gap-2 px-4 py-2.5 text-sm text-foreground hover:bg-accent hover:text-accent-foreground"
            >
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-orange-500" aria-hidden="true"></span>
              {firstHeading(d.id)}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-muted-foreground">No runbooks yet.</p>
    )}
  </section>

  {/* Footer CTA */}
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="rounded-xl border bg-card p-8 text-center">
      <GitFork class="mx-auto h-6 w-6 text-muted-foreground" />
      <h2 class="mt-3 text-2xl font-semibold tracking-tight">Ready to dig in?</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-muted-foreground">
        The docs walk the full system end to end. Each page names the files it
        describes, so you can read the code alongside the docs.
      </p>
      <a
        href={`/docs/${FIRST_PAGE.fullSlug}`}
        class="mt-5 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        Start with the agent overview
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>
  </section>
</Site>
