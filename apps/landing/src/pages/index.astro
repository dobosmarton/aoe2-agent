---
import Site from "@/layouts/Site.astro";
import CodeFigure from "@/components/CodeFigure.astro";
import { PackageMap } from "@/components/figures/PackageMap.tsx";
import { ArenaScreenshots } from "@/components/figures/ArenaScreenshots.tsx";
import Walkthrough from "@/components/walkthrough/Walkthrough.astro";
import { DotPlot } from "@/components/charts/DotPlot.tsx";
import { CellFooter, SectionLabel, cellClass } from "@/components/ui/frame";
import { getCollection } from "astro:content";
import { getPage } from "@/lib/taxonomy";
import { ArrowRight } from "lucide-react";

// The page opens with one agent turn as a scroll-driven scene (Walkthrough), then the
// detector's test results, reading paths, how to run it, the workspace and the arena UI.

// Reading paths: short routes through the docs for readers who do not want to read
// every section in order. Page titles come from taxonomy.ts.
const READING_PATHS = [
  {
    title: "15-minute tour",
    description: "The whole system in one sitting: how the agent decides, what it sees, and how the arena compares variants.",
    pages: ["agent/overview", "detection/detector", "arena/overview"],
  },
  {
    title: "LLM-agent design",
    description: "The strategist, policy and executor split, the provider wires, prompts and context, and prompt evolution scored on real games.",
    pages: [
      "agent/overview",
      "agent/decision-loops",
      "agent/llm-providers",
      "agent/prompts-and-context",
      "autoresearch/overview",
      "autoresearch/mutation-and-memory",
    ],
  },
  {
    title: "Computer vision",
    description: "The YOLO26n detector and its 65 classes, serving and evaluation, training data, labeling and sprite extraction.",
    pages: [
      "detection/detector",
      "detection/serving-and-evaluation",
      "detection/training",
      "detection/labeling",
      "detection/sprite-extraction",
    ],
  },
  {
    title: "Arena infrastructure",
    description: "The event broker, the DuckDB event log, Bradley-Terry ranking, the world sim, the API and the run viewer.",
    pages: [
      "arena/overview",
      "arena/event-broker",
      "arena/event-log-and-replay",
      "arena/ranking",
      "arena/world-sim",
      "web/architecture",
      "web/run-viewer",
    ],
  },
];

const QUICK_START = `# Python workspace and the two frontend apps
uv sync
bun install

# Detection server on the macOS host
just server --model packages/detection/src/inference/models/aoe2_yolo_v12_nms736.onnx

# The agent: stop after 20 perception frames
just agent --iterations 20`;

// Release v12 on the independent test set (packages/detection/registry/aoe2-entity-detector/
// evaluation.json): the ten classes with the most labelled boxes.
const DETECTOR_ROWS = [
  { row: "tree (405)", precision: 0.978, recall: 0.877 },
  { row: "villager (335)", precision: 0.854, recall: 0.8 },
  { row: "house (101)", precision: 1.0, recall: 0.97 },
  { row: "gold mine (71)", precision: 1.0, recall: 0.761 },
  { row: "sheep (66)", precision: 0.929, recall: 0.591 },
  { row: "deer (62)", precision: 0.857, recall: 0.581 },
  { row: "boar (55)", precision: 0.898, recall: 0.964 },
  { row: "stone mine (49)", precision: 0.971, recall: 0.673 },
  { row: "berry bush (40)", precision: 0.938, recall: 0.75 },
  { row: "town center (39)", precision: 1.0, recall: 1.0 },
];

const docs = await getCollection("docs");
const runbooks = docs.filter((doc) => doc.id.startsWith("runbooks/")).sort((a, b) => a.id.localeCompare(b.id));

const runbookTitle = (id: string): string => {
  const name = id.split("/").pop()?.replace(/\.md$/, "").replace(/^\d+-/, "").replace(/-/g, " ") ?? id;
  return name.charAt(0).toUpperCase() + name.slice(1);
};

const section = "mx-auto max-w-6xl px-4 pt-28";
const sectionTitle = "mt-5 font-heading text-3xl font-bold tracking-tight text-balance sm:text-4xl";
const sectionIntro = "mt-3 max-w-2xl text-muted-foreground";
const accentLink =
  "inline-flex items-center gap-2 py-2 text-sm text-accent-foreground underline-offset-4 hover:text-muted-foreground hover:underline";
---

<Site>
  <Walkthrough />

  <section id="detector" class={`${section} reveal`}>
    <SectionLabel aside="40 test screenshots">What the agent sees</SectionLabel>
    <h2 class={sectionTitle}>A small detector, tested on real screenshots</h2>
    <p class={sectionIntro}>
      The served YOLO26n model finds 65 classes. On 40 held-out screenshots with 1,248 labelled boxes it scores precision
      0.930, recall 0.823 and F1 0.873.
    </p>
    <div class="mt-8">
      <DotPlot
        client:visible
        title="Precision and recall by class on the independent test set"
        caption="The ten classes with the most test boxes, release v12. The vertical line is the overall F1."
        labelWidth={120}
        rows={DETECTOR_ROWS.map((entry) => entry.row)}
        series={[
          { key: "precision", label: "Precision", color: "primary" },
          { key: "recall", label: "Recall", color: "secondary" },
        ]}
        panels={[
          {
            domain: [0.5, 1],
            ticks: [0.5, 0.6, 0.7, 0.8, 0.9, 1],
            decimals: 2,
            axisLabel: "Share of boxes",
            connect: true,
            reference: { value: 0.873, label: "overall F1 0.873" },
            points: DETECTOR_ROWS.flatMap((entry) => [
              { row: entry.row, series: "precision", value: entry.precision, tip: `${entry.row}: precision ${entry.precision.toFixed(3)}` },
              { row: entry.row, series: "recall", value: entry.recall, tip: `${entry.row}: recall ${entry.recall.toFixed(3)}` },
            ]),
          },
        ]}
      />
    </div>
    <a href="/docs/detection/serving-and-evaluation" class={`mt-4 ${accentLink}`}>
      Read about serving and evaluation <ArrowRight className="h-4 w-4" />
    </a>
  </section>

  <section id="reading-paths" class={`${section} reveal`}>
    <SectionLabel aside="5 sections">Start reading</SectionLabel>
    <h2 class={sectionTitle}>Pick a reading path</h2>
    <p class={sectionIntro}>Short routes through the docs. Or start at the agent overview and read in order.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        READING_PATHS.map((path) => {
          const first = getPage(path.pages[0]);
          return (
            <a
              href={`/docs/${path.pages[0]}`}
              class="group flex flex-col overflow-hidden rounded-lg border border-foreground/10 bg-card transition-[border-color,box-shadow] duration-200 hover:border-accent-foreground/50 hover:shadow-[0_12px_32px_-16px_rgb(0_0_0/0.25)]"
            >
              <div class="cell-header">
                <span class="bracket-label">{path.pages.length} pages</span>
                <ArrowRight className="h-3.5 w-3.5 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-accent-foreground" />
              </div>
              <div class="flex-1 px-4 py-4">
                <h3 class="font-heading text-xl font-bold text-foreground group-hover:text-accent-foreground">
                  {path.title}
                </h3>
                <p class="mt-1.5 text-sm leading-snug text-muted-foreground">{path.description}</p>
              </div>
              <CellFooter>Starts with {first?.section.title}: {first?.page.title}</CellFooter>
            </a>
          );
        })
      }
    </div>
  </section>

  <section id="quick-start" class={`${section} reveal`}>
    <SectionLabel aside="Repository root">Run it</SectionLabel>
    <h2 class={sectionTitle}>Install, start, and fix</h2>
    <p class={sectionIntro}>
      The agent runs in a Windows VM that calls a detection server on the Mac host, or natively on macOS. The runbooks
      cover what to do when something breaks.
    </p>
    <div class="mt-8 grid gap-10 lg:grid-cols-5 lg:gap-8">
      <div class="artifacts min-w-0 lg:col-span-3">
        <CodeFigure code={QUICK_START} lang="bash" />
        <a href="/docs/runbooks/deployment" class={`mt-4 ${accentLink}`}>
          Deployment runbook <ArrowRight className="h-4 w-4" />
        </a>
      </div>
      <div id="runbooks" class="min-w-0 lg:col-span-2">
        <div class={cellClass}>
          <div class="cell-header">
            <span class="bracket-label">Runbooks</span>
            <span class="cell-aside">{runbooks.length} guides</span>
          </div>
          <ol class="list-none divide-y divide-foreground/[0.07]">
            {
              runbooks.map((runbook) => (
                <li>
                  <a
                    href={`/docs/${runbook.id}`}
                    class="group flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-accent-foreground/[0.06]"
                  >
                    <span class="flex-1 text-foreground group-hover:text-accent-foreground">{runbookTitle(runbook.id)}</span>
                    <ArrowRight className="h-3.5 w-3.5 text-muted-foreground transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section id="packages" class={`${section} reveal`}>
    <SectionLabel aside="uv workspace">The repository</SectionLabel>
    <h2 class={sectionTitle}>Nine Python workspace members</h2>
    <p class={sectionIntro}>
      Members share types through <code class="font-mono text-[0.9em]">core</code>. Hover a cell to see what it depends on.
    </p>
    <div class="mt-8">
      <PackageMap client:visible />
    </div>
  </section>

  <section class={`${section} reveal`}>
    <SectionLabel aside="Internal tool">The arena UI</SectionLabel>
    <h2 class={sectionTitle}>Watch a run, turn by turn</h2>
    <p class={sectionIntro}>The arena UI shows what the agent perceives, decides and does. Click a panel to expand it.</p>
    <div class="mt-8">
      <ArenaScreenshots client:visible />
    </div>
  </section>
</Site>
