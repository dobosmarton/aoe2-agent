---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Doc from "@/layouts/Doc.astro";
import { isSectionPage } from "@/lib/taxonomy";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Title precedence: frontmatter > first H1 heading > slug.
const title =
  entry.data.title ??
  headings.find((h) => h.depth === 1)?.text ??
  entry.id.split("/").pop() ??
  "Documentation";
const description = entry.data.description;

// Reading time from the markdown source, at 230 words per minute.
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 230));

// Pages under a section directory (agent/, detection/, arena/, web/,
// autoresearch/) get the sidebar, timeline and prev/next links.
const isGuidePage = isSectionPage(entry.id);
---

<Doc
  title={title}
  description={description}
  slug={isGuidePage ? entry.id : undefined}
  headings={headings}
  readMinutes={readMinutes}
>
  <Content />
</Doc>
