---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Doc from "@/layouts/Doc.astro";
import Site from "@/layouts/Site.astro";
import { isSectionPage } from "@/lib/taxonomy";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Title precedence: frontmatter > first H1 heading > slug.
const title =
  entry.data.title ??
  headings.find((h) => h.depth === 1)?.text ??
  entry.id.split("/").pop() ??
  "Documentation";
const description = entry.data.description;

// Pages under a section directory (agent/, detection/, arena/, web/,
// autoresearch/) get the sidebar, timeline and prev/next links.
const isGuidePage = isSectionPage(entry.id);
---

{
  isGuidePage ? (
    <Doc title={title} description={description} slug={entry.id}>
      <Content />
    </Doc>
  ) : (
    <Site title={`${title} — AoE2 LLM Arena`} description={description}>
      <div class="mx-auto max-w-3xl px-4 py-10">
        <article data-pagefind-body class="prose-doc">
          <Content />
        </article>
      </div>
    </Site>
  )
}
