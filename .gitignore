logs/
venv/
.venv
__pycache__/
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/

# basedpyright: track the baseline (grandfathered errors), ignore caches.
.basedpyright/*
!.basedpyright/baseline.json

.coverage
.coverage.*
htmlcov/
coverage.xml
.vscode/
.idea/
.DS_Store
# Real env files stay out; the documented template is tracked (same idiom as the
# basedpyright baseline above). `.env` itself is covered by the bare rule at the top.
.env.*
!.env.example

# Logs / debug captures (any pattern at repo root or nested)
logs.*
logs[0-9]*.txt
logs_*.txt

game_graphics/
game_terrain/
tmp/
.superset/

# Build / packaging artifacts (setuptools, uv).
# `*.egg-info/` is a wildcard — catches every workspace member's egg-info,
# whether at `packages/<name>/<name>.egg-info/` (setuptools default) or
# `packages/<name>/src/<name>.egg-info/` (our src-layout).
*.egg-info/
build/
dist/

# WIP scratch dirs (kept out of git deliberately). This includes the experiment
# ledger (experiments/results.tsv): it stays machine-local — the VM that runs
# the games is its source of truth; run the merge gate (experiment_gate) there.
experiments/
overlay-update.zip
# Pre-implementation plans, design sketches, scratch notes — written while a
# feature is in flight; replaced by canonical docs under docs/design/ when
# the work lands. Kept out of git so stale planning docs don't accumulate.
docs/plan/

# Root markdown is scratch by default — plans and notes stay machine-local.
# README.md is the one shared root doc; canonical docs live under docs/.
/*.md
!/README.md

# Claude Code per-user state — `scheduled_tasks.lock`, `settings.local.json`,
# anything else the harness writes locally. Machine-specific, no value to
# other contributors. Equivalent of `.vscode/` for the Claude Code workflow.
.claude/

# JS workspace — root hoisted node_modules + per-app build artefacts.
node_modules/
apps/dashboard/dist/
apps/dashboard/.vite/
apps/dashboard/*.tsbuildinfo
apps/landing/dist/
apps/landing/.astro/
apps/landing/node_modules/

# Vercel CLI local state — `.vercel/project.json` holds org/project IDs, and CI
# assembles `.vercel/output/` (Build Output API) at deploy time. Never committed.
.vercel/

# Detection: training images, screenshots, label outputs — large, regenerated.
packages/detection/src/**/training_data*/
packages/detection/src/real_screenshots/
packages/detection/src/labeling/output/
training_data*.tar.gz

# Model weights — large binaries, mostly regenerated. Keep only the deployed
# model snapshots checked in via the negation patterns at the bottom.
**/models/*.pt
**/models/*.onnx
**/models/*.mlpackage/
yolov8n.pt
yolo11n.pt
!packages/detection/src/inference/models/aoe2_yolo_v5.pt
!packages/detection/src/inference/models/aoe2_yolo_v5.onnx
