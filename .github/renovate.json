{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Budapest",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "pinDigests": true,
  "docker": {
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch + minor digest bumps for compose services.",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Major version bumps for compose services need human review.",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Auto-merge uv.lock bumps within existing pyproject ranges.",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Group GitHub Actions updates so the renovate-PR stream is manageable.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["before 6am on monday"]
    }
  ],
  "ignorePaths": [
    "venv/**",
    ".venv/**",
    "experiments/**",
    "logs/**",
    "tmp/**"
  ]
}
